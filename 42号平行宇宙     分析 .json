    {
      "objclass": "NarrativeProperties",
      "objdata": {
        "Flow": [
          {
            "Character": "winnie",
            "Action": "NPC_ENTER"
          },
          {
            "Character": "winnie",
            "Action": "SAY",
            "Lines": {
              "zh": "这些植物与僵尸可真奇怪。"
            }
          },
          {
            "Character": "crazydave",
            "Action": "NPC_ENTER",
            "Lines": {
              "zh": ""
            }
          },
          {
            "Character": "winnie",
            "Action": "SAY",
            "Lines": {
              "zh": "啊，用户戴夫，终于找到你了！我们得尽快找到离开这里的办法！"
            }
          },
          {
            "Character": "crazydave",
            "Action": "TIRED",
            "Lines": {
              "zh": "什么，离开这里？"
            }
          },
          {
            "Character": "crazydave",
            "Action": "SAY",
            "Lines": {
              "zh": "哦，我有必要向你声明：我叫硬汉戴夫，和你想找的那个戴夫恐怕不是同一个人。"
            }
          },
          {
            "Character": "winnie",
            "Action": "TIRED",
            "Lines": {
              "zh": "啊？这样吗？"
            }
          },
          {
            "Character": "winnie",
            "Action": "SAY",
            "Lines": {
              "zh": "那么，硬汉戴夫先生，请问你知道——"
            }
          },
          {
            "Character": "crazydave",
            "Action": "EXCITED",
            "Lines": {
              "zh": "先别聊了！帅哥僵博的僵尸大军要来了！"
            }
          }
        ]
      },
      "aliases": [
        "EditorFirstIntroNarrative"
      ]
    },
