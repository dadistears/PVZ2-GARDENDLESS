    {
      "objclass": "NarrativeProperties",
      "aliases": [
        "EditorFirstIntroNarrative"
      ],
      "objdata": {
        "Flow": [
          {
            "Character": "zombossicon",
            "Action": "NPC_ENTER"
          },
          {
            "Character": "zombossicon",
            "Action": "SAY",
            "Lines": {
              "en": "Gurrreetings! Dr. Zomboss have prehistoric question for pitiful plant friends.",
              "zh": "没想到你们居然能找到我的秘密基地，看来我得给你们一点教训......"
            }
          },
          {
            "Character": "zombossicon",
            "Action": "SAY",
            "Lines": {
              "en": "Why you hunt for taco? Is taco all it cracked up to be?",
              "zh": "正好我的新作品已经完成了，虽然动力系统还得完善，但对付你们应该足够了......"
            }
          },
          {
            "Character": "zombossicon",
            "Action": "SAY",
            "Lines": {
              "en": "Could it be ... trap? Could it be ... trick?",
              "zh": "那么，你们就好好享受这场美妙的宴会吧！啊哈哈哈哈！！！"
            }
          },
          {
            "Character": "zombossicon",
            "Action": "NPC_EXIT"
          },
          {
            "Character": "crazydave",
            "Action": "NPC_ENTER"
          },
          {
            "Character": "winnie",
            "Action": "NPC_ENTER"
          },
          {
            "Character": "crazydave",
            "Action": "EXCITED",
            "Lines": {
              "en": "Penny ... my taco!?!",
              "zh": "潘妮，这家伙怎么疯疯癫癫的？宴会.....?会有我想要的玉米卷吗？"
            }
          },
          {
            "Character": "winnie",
            "Action": "TIRED",
            "Lines": {
              "en": "User Dave, ignore the taco. Ignore the taunts.",
              "zh": "哦，亲爱的戴夫，忘记玉米卷吧......"
            }
          },
          {
            "Character": "winnie",
            "Action": "EXCITED",
            "Lines": {
              "en": "It's time to FIGHT DR. ZOMBOSS!",
              "zh": "我们得先解决僵尸博士再说！"
            }
          }
        ]
      }
    },
    {
      "objclass": "NarrativeProperties",
      "aliases": [
        "EditorFirstOutroNarrative"
      ],
      "objdata": {
        "Flow": [
          {
            "Character": "crazydave",
            "Action": "NPC_ENTER"
          },
          {
            "Character": "winnie",
            "Action": "NPC_ENTER"
          },
          {
            "Character": "winnie",
            "Action": "EXCITED",
            "Lines": {
              "en": "Well done. We have defeated Dr. Zomboss.",
              "zh": "干得漂亮。我们已击败僵尸博士。"
            }
          },
          {
            "Character": "crazydave",
            "Action": "EXCITED",
            "Lines": {
              "en": "And his attempt to make me question my taco!",
              "zh": "还有他试图让我参加宴会吃到玉米卷的阴谋！"
            }
          },
          {
            "Character": "winnie",
            "Action": "TIRED",
            "Lines": {
              "en": "User Dave, our journey through time ...",
              "zh": "戴夫，我们的时空之旅……"
            }
          },
          {
            "Character": "winnie",
            "Action": "SAY",
            "Lines": {
              "en": "You know that it is about more than just a taco.",
              "zh": "你明白这不仅仅关乎一个玉米卷。"
            }
          },
          {
            "Character": "crazydave",
            "Action": "TIRED",
            "Lines": {
              "en": "I suppose you're right, Penny. It's also about-",
              "zh": "我想你是对的，潘妮。这还关乎——"
            }
          },
          {
            "Character": "crazydave",
            "Action": "NPC_EXIT"
          },
          {
            "Character": "winnie",
            "Action": "NPC_EXIT"
          },
          {
            "Character": "zombossicon",
            "Action": "NPC_ENTER"
          },
          {
            "Character": "zombossicon",
            "Action": "SAY",
            "Lines": {
              "en": "Ha! Dr. Zomboss not defeated!",
              "zh": "可恶！我的新作品居然又被你们打败了！"
            }
          },
          {
            "Character": "zombossicon",
            "Action": "SAY",
            "Lines": {
              "zh": "你们给我等着，阿......阿嚏！我还会在不同的时空等着你们交出脑子！"
            }
          },
          {
            "Character": "zombossicon",
            "Action": "SAY",
            "Lines": {
              "zh": "阿......阿嚏！！！！！"
            }
          }
        ]
      }
    }
